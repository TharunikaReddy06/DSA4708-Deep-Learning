#8. An image-processing system uses the matrix below to analyze patterns in image features. A = [[4, 2], [2, 4]]. Write a Python program to calculate the eigenvalues of the matrix and to display the eigenvalues in a bar chart.
import numpy as np
import matplotlib.pyplot as plt

A = np.array([[4, 2],
              [2, 4]])

values = np.linalg.eigvals(A)
print("Eigenvalues:", values)

plt.bar(["Eigenvalue 1", "Eigenvalue 2"], values)
plt.title("Eigenvalues of Matrix")
plt.ylabel("Value")
plt.show()
