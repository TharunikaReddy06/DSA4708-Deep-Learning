#12. A lecturer observes that students’ examination marks approximately follow a normal distribution with a mean of 70 and a standard deviation of 10. Write a Python program to calculate the probability that a randomly selected student scores between 60 and 80, and to plot the normal distribution with the interval highlighted.
import numpy as np
import matplotlib.pyplot as plt
from scipy.stats import norm

mean, sd = 70, 10
prob = norm.cdf(80, mean, sd) - norm.cdf(60, mean, sd)
print("P(60 <= X <= 80):", prob)

x = np.linspace(40, 100, 300)
y = norm.pdf(x, mean, sd)

plt.plot(x, y)
plt.fill_between(x, y, where=(x >= 60) & (x <= 80),
                 alpha=0.4)
plt.title("Normal Distribution")
plt.xlabel("Marks")
plt.ylabel("Density")
plt.show()
