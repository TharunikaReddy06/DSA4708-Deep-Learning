#18. Two language models predict the next word using the probability distributions P=[0.5,0.3,0.2] and Q=[0.4,0.4,0.2]. A developer wants to measure how much the second model's distribution differs from the first. Write a Python program to calculate the KL divergence and to compare the two probability distributions with a grouped bar chart.
import numpy as np
import matplotlib.pyplot as plt
from scipy.stats import entropy

P = np.array([0.5, 0.3, 0.2])
Q = np.array([0.4, 0.4, 0.2])

print("KL Divergence:", entropy(P, Q))

x = np.arange(3)
plt.bar(x - 0.2, P, 0.4, label="P")
plt.bar(x + 0.2, Q, 0.4, label="Q")
plt.xticks(x, ["Word 1", "Word 2", "Word 3"])
plt.legend()
plt.title("Probability Distribution Comparison")
plt.show()
