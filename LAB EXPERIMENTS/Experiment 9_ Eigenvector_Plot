#9. A machine learning model uses eigenvectors to identify important directions in a two-dimensional dataset. The covariance matrix is C = [[3, 1], [1, 3]]. Write a Python program to calculate the eigenvalues and eigenvectors of the covariance matrix, and to plot the eigenvectors as arrows from the origin in a two-dimensional coordinate system.
import numpy as np
import matplotlib.pyplot as plt

C = np.array([[3, 1],
              [1, 3]])

values, vectors = np.linalg.eig(C)
print("Eigenvalues:", values)
print("Eigenvectors:\n", vectors)

for i in range(2):
    plt.quiver(0, 0, vectors[0, i], vectors[1, i],
               angles="xy", scale_units="xy",
               scale=1, label=f"Eigenvector {i+1}")

plt.xlim(-1.5, 1.5)
plt.ylim(-1.5, 1.5)
plt.axhline(0, color="gray")
plt.axvline(0, color="gray")
plt.grid()
plt.legend()
plt.title("Eigenvectors")
plt.show()
