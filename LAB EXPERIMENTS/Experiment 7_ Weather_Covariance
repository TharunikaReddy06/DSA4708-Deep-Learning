# 1.A hospital uses a deep learning model to classify medical images. A small grayscale image is represented by a  3×3 matrix of pixel intensities. 
# Before classification, the image must be converted into a one-dimensional vector, and the total pixel intensity must be calculated. 

import numpy as np
import matplotlib.pyplot as plt

temp = [22, 25, 28, 30, 32]
humidity = [80, 75, 68, 60, 55]

C = np.cov(temp, humidity)
print("Covariance Matrix:\n", C)

plt.scatter(temp, humidity)
plt.xlabel("Temperature")
plt.ylabel("Humidity")
plt.title("Temperature vs Humidity")
plt.grid()
plt.show()
