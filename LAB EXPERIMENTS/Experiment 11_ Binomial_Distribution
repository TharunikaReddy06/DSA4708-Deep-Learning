#11. A factory produces electronic components, and the probability that a component is defective is 0.1. A quality inspector randomly selects 20 components. The number of defective components follows a binomial distribution. Write a Python program to calculate the probability that exactly 3 components are defective, and to plot the probability mass function for 0 to 20 defective components.
import numpy as np
import matplotlib.pyplot as plt
from scipy.stats import binom

n, p = 20, 0.1
x = np.arange(21)
prob = binom.pmf(x, n, p)

print("P(X = 3):", binom.pmf(3, n, p))

plt.bar(x, prob)
plt.xlabel("Number of Defective Components")
plt.ylabel("Probability")
plt.title("Binomial Distribution")
plt.show()
