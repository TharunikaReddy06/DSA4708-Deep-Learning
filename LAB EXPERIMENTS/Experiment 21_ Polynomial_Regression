#21. A real estate company develops machine learning models to predict house prices based on house area. A linear regression model and polynomial regression models of degrees 2 and 10 are trained using the same dataset. The company wants to compare how model complexity affects prediction performance. Write a Python program to generate sample house-price data, train polynomial regression models of degrees 1, 2, and 10, and to plot their prediction curves against the actual data.
import numpy as np
import matplotlib.pyplot as plt
from sklearn.preprocessing import PolynomialFeatures
from sklearn.linear_model import LinearRegression

np.random.seed(42)
X = np.linspace(1, 10, 30).reshape(-1, 1)
y = 3 * X.ravel() + 2 + np.random.normal(0, 4, 30)

plt.scatter(X, y, label="Actual Data")

for degree in [1, 2, 10]:
    poly = PolynomialFeatures(degree=degree)
    model = LinearRegression().fit(poly.fit_transform(X), y)

    x_plot = np.linspace(1, 10, 200).reshape(-1, 1)
    y_plot = model.predict(poly.transform(x_plot))

    plt.plot(x_plot, y_plot, label=f"Degree {degree}")

plt.xlabel("House Area")
plt.ylabel("House Price")
plt.title("Polynomial Regression")
plt.legend()
plt.show()
