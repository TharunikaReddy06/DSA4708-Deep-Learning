#10. An intelligent monitoring system collects measurements from two sensors. The covariance matrix of the measurements is C = [[5, 2], [2, 2]]. The system uses eigenvalue and eigenvector analysis to identify the principal direction of variation in the sensor data. Write a Python program using NumPy to calculate the eigenvalues and eigenvectors, identify the eigenvector corresponding to the largest eigenvalue, and use Matplotlib to visualize both eigenvectors as arrows on a two-dimensional graph.
import numpy as np
import matplotlib.pyplot as plt

C = np.array([[5, 2],
              [2, 2]])

values, vectors = np.linalg.eig(C)
i = np.argmax(values)

print("Eigenvalues:", values)
print("Eigenvectors:\n", vectors)
print("Largest Eigenvalue:", values[i])
print("Principal Direction:", vectors[:, i])

for j in range(2):
    plt.quiver(0, 0, vectors[0, j], vectors[1, j],
               angles="xy", scale_units="xy",
               scale=1, label=f"Eigenvector {j+1}")

plt.xlim(-1.2, 1.2)
plt.ylim(-1.2, 1.2)
plt.axhline(0, color="gray")
plt.axvline(0, color="gray")
plt.grid()
plt.legend()
plt.title("Principal Direction Analysis")
plt.show()
