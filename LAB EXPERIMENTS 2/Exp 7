# Question 7
import numpy as np
import matplotlib.pyplot as plt
import tensorflow as tf
from tensorflow import keras
from tensorflow.keras import layers, regularizers
 
np.random.seed(42)
# House data (scaled 0-1): area, rooms, age, distance from city center
n = 120
area = np.random.uniform(0, 1, n)
rooms = np.random.uniform(0, 1, n)
age = np.random.uniform(0, 1, n)
dist = np.random.uniform(0, 1, n)
X = np.column_stack([area, rooms, age, dist])
y = (0.5 * area + 0.2 * rooms - 0.15 * age - 0.1 * dist
     + np.random.normal(0, 0.08, n))
 
# Same training / validation split for all three models
idx = np.random.permutation(n)
tr, va = idx[:50], idx[50:]
X_tr, y_tr, X_va, y_va = X[tr], y[tr], X[va], y[va]
 
def build(kind):
    reg = regularizers.l2(0.01) if kind == "L2" else None
    model = keras.Sequential([keras.Input(shape=(4,))])
    model.add(layers.Dense(128, activation="relu", kernel_regularizer=reg))
    if kind == "Dropout":
        model.add(layers.Dropout(0.3))
    model.add(layers.Dense(128, activation="relu", kernel_regularizer=reg))
    if kind == "Dropout":
        model.add(layers.Dropout(0.3))
    model.add(layers.Dense(1))
    return model
 
def train(kind):
    tf.keras.utils.set_random_seed(42)
    model = build(kind)
    model.compile(optimizer=keras.optimizers.Adam(0.001), loss="mse")
    h = model.fit(X_tr, y_tr, epochs=200, batch_size=16,
                  validation_data=(X_va, y_va), verbose=0)
    return np.array(h.history["loss"]), np.array(h.history["val_loss"])
 
kinds = ["Baseline", "L2", "Dropout"]
runs = {k: train(k) for k in kinds}
 
print("Model      Train Loss  Val Loss  Gap (val-train)  Best Val Loss")
for k, (tl, vl) in runs.items():
    print(f"{k:9s}  {tl[-1]:.4f}      {vl[-1]:.4f}    {vl[-1]-tl[-1]:.4f}"
          f"           {vl.min():.4f}")
best = min(runs, key=lambda k: runs[k][1][-1])
print("Best generalization (lowest final validation loss):", best)
 
fig, ax = plt.subplots(1, 3, figsize=(15, 4))
for a, (k, (tl, vl)) in zip(ax, runs.items()):
    a.plot(tl, label="Training loss")
    a.plot(vl, label="Validation loss")
    a.set_title(k)
    a.set_xlabel("Epoch")
    a.set_ylabel("MSE")
    a.legend()
    a.grid()
plt.tight_layout()
plt.show()
