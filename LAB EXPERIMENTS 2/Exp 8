# Question 8
import time
import numpy as np
import matplotlib.pyplot as plt
import tensorflow as tf
from tensorflow import keras
from tensorflow.keras import layers
 
np.random.seed(42)
# Appointment data: lead time (scaled), previous attendance, reminder sent
n = 300
lead = np.random.uniform(0, 1, n)
prev = np.random.uniform(0, 1, n)
reminder = np.random.randint(0, 2, n)
X = np.column_stack([lead, prev, reminder])
logit = 3 * lead - 3 * prev - 1.5 * reminder + 0.5
prob = 1 / (1 + np.exp(-logit))
y = (np.random.uniform(0, 1, n) < prob).astype(int)     # 1 = no-show
 
idx = np.random.permutation(n)
tr, va = idx[:100], idx[100:]
X_tr, y_tr, X_va, y_va = X[tr], y[tr], X[va], y[va]
 
def build(dropout=0.0):
    model = keras.Sequential([
        keras.Input(shape=(3,)),
        layers.Dense(64, activation="relu"),
        layers.Dropout(dropout),
        layers.Dense(64, activation="relu"),
        layers.Dropout(dropout),
        layers.Dense(1, activation="sigmoid")
    ])
    model.compile(optimizer=keras.optimizers.Adam(0.005),
                  loss="binary_crossentropy", metrics=["accuracy"])
    return model
 
def train(dropout=0.0, early=False):
    tf.keras.utils.set_random_seed(42)
    model = build(dropout)
    cb = []
    if early:
        cb = [keras.callbacks.EarlyStopping(monitor="val_loss", patience=10,
                                            restore_best_weights=True)]
    start = time.time()
    h = model.fit(X_tr, y_tr, epochs=200, batch_size=16,
                  validation_data=(X_va, y_va), callbacks=cb, verbose=0)
    secs = time.time() - start
    vl, vacc = model.evaluate(X_va, y_va, verbose=0)    # final weights
    return (np.array(h.history["loss"]), np.array(h.history["val_loss"]),
            np.array(h.history["accuracy"]), vl, vacc, secs)
 
runs = {
    "Baseline": train(),
    "Dropout (0.4)": train(dropout=0.4),
    "Early stopping": train(early=True),
}
 
print("Model            Epochs  Time(s)  Train Acc  Val Acc  Val Loss")
for k, (tl, vl, ta, fvl, fva, secs) in runs.items():
    print(f"{k:15s}  {len(tl):5d}   {secs:6.2f}   {ta[-1]:.4f}    "
          f"{fva:.4f}   {fvl:.4f}")
best = min(runs, key=lambda k: runs[k][3])
print("Recommended approach (lowest validation loss):", best)
 
fig, ax = plt.subplots(1, 3, figsize=(15, 4))
for a, (k, (tl, vl, *_)) in zip(ax, runs.items()):
    a.plot(tl, label="Training loss")
    a.plot(vl, label="Validation loss")
    a.set_title(k)
    a.set_xlabel("Epoch")
    a.set_ylabel("Binary cross-entropy")
    a.legend()
    a.grid()
plt.tight_layout()
plt.show()
