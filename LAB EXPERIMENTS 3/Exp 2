# Question 2
import numpy as np
from tensorflow import keras
from tensorflow.keras import layers

# Training sequences: previous three values -> next value
X = np.array([[10, 20, 30],
              [20, 30, 40],
              [30, 40, 50],
              [40, 50, 60],
              [50, 60, 70]], dtype="float32")
y = np.array([40, 50, 60, 70, 80], dtype="float32")

# Scale the data and reshape to (samples, time steps, features)
X = (X / 100.0).reshape(5, 3, 1)
y = y / 100.0

model = keras.Sequential([
    keras.Input(shape=(3, 1)),
    layers.SimpleRNN(50, activation="relu"),
    layers.Dense(1)
])
model.summary()

model.compile(optimizer=keras.optimizers.Adam(0.01), loss="mse")
model.fit(X, y, epochs=300, verbose=0)

# Predict the next value for 60, 70, 80
test = (np.array([60, 70, 80], dtype="float32") / 100.0).reshape(1, 3, 1)
pred = model.predict(test, verbose=0) * 100
print("Input sequence       : 60, 70, 80")
print("Predicted next value :", round(float(pred[0, 0]), 2))
