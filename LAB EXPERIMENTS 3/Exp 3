# Question 3
import numpy as np
from tensorflow import keras
from tensorflow.keras import layers
from tensorflow.keras.preprocessing.text import Tokenizer
from tensorflow.keras.preprocessing.sequence import pad_sequences

reviews = ["I love this product",
           "Excellent quality",
           "Very useful product",
           "I hate this product",
           "Very poor quality",
           "Product is terrible"]
labels = np.array([1, 1, 1, 0, 0, 0])     # 1 = Positive, 0 = Negative

# Text -> integer sequences -> padded sequences
tokenizer = Tokenizer(oov_token="<OOV>")
tokenizer.fit_on_texts(reviews)
sequences = tokenizer.texts_to_sequences(reviews)
max_len = max(len(s) for s in sequences)
X = pad_sequences(sequences, maxlen=max_len, padding="pre")
vocab_size = len(tokenizer.word_index) + 1
print("Word index:", tokenizer.word_index)
print("Padded sequences:\n", X)

model = keras.Sequential([
    keras.Input(shape=(max_len,)),
    layers.Embedding(vocab_size, 8),
    layers.SimpleRNN(8),
    layers.Dense(1, activation="sigmoid")
])
model.summary()

model.compile(optimizer=keras.optimizers.Adam(0.01),
              loss="binary_crossentropy", metrics=["accuracy"])
model.fit(X, labels, epochs=200, verbose=0)
loss, acc = model.evaluate(X, labels, verbose=0)
print("Training accuracy =", acc)

# Test with a new review
new_review = ["Excellent product"]
seq = tokenizer.texts_to_sequences(new_review)
seq = pad_sequences(seq, maxlen=max_len, padding="pre")
prob = float(model.predict(seq, verbose=0)[0, 0])
print("Review    :", new_review[0])
print("Probability of positive =", round(prob, 3))
print("Sentiment :", "Positive" if prob > 0.5 else "Negative")
