import numpy as np
from tensorflow import keras
from tensorflow.keras import layers

# Electricity consumption (units) for Day 1 to Day 12
usage = np.array([100, 115, 120, 130, 145, 150,
                  165, 170, 185, 190, 205, 215], dtype="float32")

# Sliding window: previous 3 days -> next day
window = 3
X, y = [], []
for i in range(len(usage) - window):
    X.append(usage[i:i + window])
    y.append(usage[i + window])
X = np.array(X) / 100.0
y = np.array(y) / 100.0
X = X.reshape(-1, window, 1)
print("Training samples =", len(X))

model = keras.Sequential([
    keras.Input(shape=(window, 1)),
    layers.SimpleRNN(50, activation="relu"),
    layers.Dense(1)
])
model.summary()

model.compile(optimizer=keras.optimizers.Adam(0.01), loss="mse")
history = model.fit(X, y, epochs=300, verbose=0)
print("Final training loss =", history.history["loss"][-1])

# Estimate Day 13 from Day 10, 11 and 12
last = (usage[-3:] / 100.0).reshape(1, window, 1)
pred = model.predict(last, verbose=0) * 100
print("Last three days    :", usage[-3:])
print("Estimated consumption for Day 13 =", round(float(pred[0, 0]), 2), "units")
