# Question 7
import numpy as np
from tensorflow import keras
from tensorflow.keras import layers
from tensorflow.keras.preprocessing.text import Tokenizer
from tensorflow.keras.preprocessing.sequence import pad_sequences

sentences = ["I love machine learning",
             "I love deep learning",
             "I love artificial intelligence",
             "I like machine learning",
             "I like deep learning"]

tokenizer = Tokenizer()
tokenizer.fit_on_texts(sentences)
vocab_size = len(tokenizer.word_index) + 1
print("Word index:", tokenizer.word_index)

# Prefix sequences: e.g. [I, love] -> machine
input_sequences = []
for s in sentences:
    tokens = tokenizer.texts_to_sequences([s])[0]
    for i in range(1, len(tokens)):
        input_sequences.append(tokens[:i + 1])

max_len = max(len(s) for s in input_sequences)
input_sequences = pad_sequences(input_sequences, maxlen=max_len,
                                padding="pre")
X = input_sequences[:, :-1]        # input words
y = input_sequences[:, -1]         # next word
print("Padded input sequences:\n", X)

model = keras.Sequential([
    keras.Input(shape=(max_len - 1,)),
    layers.Embedding(vocab_size, 10),
    layers.SimpleRNN(32),
    layers.Dense(vocab_size, activation="softmax")
])
model.summary()

model.compile(optimizer=keras.optimizers.Adam(0.01),
              loss="sparse_categorical_crossentropy", metrics=["accuracy"])
model.fit(X, y, epochs=300, verbose=0)

# Test with the phrase "I love"
seed = "I love"
seq = tokenizer.texts_to_sequences([seed])[0]
seq = pad_sequences([seq], maxlen=max_len - 1, padding="pre")
probs = model.predict(seq, verbose=0)[0]
top = np.argsort(probs)[::-1][:3]
for i in top:
    print(f"{tokenizer.index_word[i]:12s} probability = {probs[i]:.3f}")
print("Input phrase   :", seed)
print("Predicted word :", tokenizer.index_word[int(top[0])])
